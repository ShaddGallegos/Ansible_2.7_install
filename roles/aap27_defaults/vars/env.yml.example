---
# Shell installer identity and execution scope
INSTALL_SCOPE: local
NONINTERACTIVE: false
ADMIN_USER: admin
ADMIN_HOME: /home/admin
ADMIN_PASSWORD: ""
AAP_REMOTE_USER: admin
AAP_REMOTE_ROOT_PASSWORD: ""
AAP_CONTROLLER_IP: ""
AAP_CONTROLLER_FQDN: ""
AAP_CONTROLLER_USER: ""
AAP_CONTROLLER_SSH_KEY: ""
ANSIBLE_VERBOSITY: ""

# Bundle selection and installer runtime
BUNDLE_URL: >-
  https://access.cdn.redhat.com/content/origin/files/sha256/5c/5c0e1834c1ae609ce840865b5aa279b5c5bde9118856b326f77cc5c8bf92d9af/ansible-automation-platform-containerized-setup-bundle-2.7-2-x86_64.tar.gz
BUNDLE_FILE: ansible-automation-platform-containerized-setup-bundle-2.7-2-x86_64.tar.gz
BUNDLE_DIR_NAME: ansible-automation-platform-containerized-setup-bundle-2.7-2-x86_64
AAP_EXECUTION_PLAYBOOK: install
AAP_ANSIBLE_PLAYBOOK: ""
AAP_AUTO_CREATE_ANSIBLE_VENV: true
AAP_APPLY_COLLECTION_PATCHES: true
AAP_CLEANUP_BUNDLE_ARCHIVE: true
AAP_CLEANUP_PURGE_DOWNLOADS: false
AAP_AUTO_CLEANUP_ON_UNINSTALL: false

# HTTP to HTTPS redirect
aap27_http_redirect_user: admin
aap27_http_redirect_home: /home/admin
aap27_http_redirect_port: 80
aap27_http_redirect_https_port: 443
aap27_http_redirect_fallback_host: aap.example.com
aap27_http_redirect_configure_unprivileged_port: true

# Resource requirements
AAP_MIN_CPU: 4
AAP_MIN_RAM_GB: 16
AAP_MIN_DISK_GB: 40

# Red Hat credentials and tokens
RHSM_USERNAME: ""
RHSM_PASSWORD: ""
RH_OFFLINE_TOKEN: ""
RH_AH_TOKEN: ""
CDN_USERNAME: ""
CDN_PASSWORD: ""
REDHAT_USERNAME: ""
REDHAT_PASSWORD: ""
CONSOLE_USERNAME: ""
CONSOLE_PASSWORD: ""

# AAP Controller authentication and resource names
aap_controller_host: https://aap.example.com
aap_validate_certs: false
aap_controller_oauthtoken: ""
aap_controller_username: admin
aap_controller_password: ""
aap_org_name: AAP 2.7 Install
aap_inventory_name: AAP 2.7 Install Inventory
aap_inventory_description: Inventory for AAP 2.7 installer workflow
workflow_project_name: Ansible_2.7_install
workflow_project_url: https://github.com/shaddgallegos/Ansible_2.7_install.git
workflow_project_branch: main
machine_credential_name: AAP Install Machine Credential
registry_credential_name: RH Registry Credential
machine_credential_username: admin
machine_credential_password: ""
registry_username: ""
registry_password: ""
jt_prework_name: AAP27 Prework
jt_host_identity_name: AAP27 Host Identity
jt_download_name: AAP27 Download Bundle
jt_install_name: AAP27 Install
aap_workflow_template_name: AAP27 End-to-End Install Workflow

# Workflow and playbook inputs
default_fqdn: aap.example.com
default_bundle_url: >-
  https://access.cdn.redhat.com/content/origin/files/sha256/5c/5c0e1834c1ae609ce840865b5aa279b5c5bde9118856b326f77cc5c8bf92d9af/ansible-automation-platform-containerized-setup-bundle-2.7-2-x86_64.tar.gz
default_bundle_file: ansible-automation-platform-containerized-setup-bundle-2.7-2-x86_64.tar.gz
target_fqdn: aap.example.com
admin_user: admin
admin_home: /home/admin
admin_password: ""
remote_user: admin
bundle_url: >-
  https://access.cdn.redhat.com/content/origin/files/sha256/5c/5c0e1834c1ae609ce840865b5aa279b5c5bde9118856b326f77cc5c8bf92d9af/ansible-automation-platform-containerized-setup-bundle-2.7-2-x86_64.tar.gz
bundle_file: ansible-automation-platform-containerized-setup-bundle-2.7-2-x86_64.tar.gz
bundle_dir_name: ansible-automation-platform-containerized-setup-bundle-2.7-2-x86_64
bundle_dir: /home/admin/Downloads/ansible-automation-platform-containerized-setup-bundle-2.7-2-x86_64
local_bundle_path: ""
cleanup_bundle_archive: true
rhsm_username: ""
rhsm_password: ""
execution_playbook: install
disable_firewall_for_install: false
set_selinux_permissive_for_install: false

# Rootless Podman and preflight inputs
rootless_podman_hosts: controller
deployment_user: admin
subuid_start: 100000
subuid_count: 65536
enable_podman_socket: true
enable_rootful_podman_socket: false
registry_login: false
preflight_hosts: controller
min_cpu: 4
min_ram_gb: 16
min_disk_gb: 40
fail_on_insufficient_resources: false

# Nested containerized installer variables
registry_auth: false
postgresql_admin_username: postgres
postgresql_admin_password: ""
redis_mode: standalone
redis_cluster: false
redis_cluster_mode: false
controller_admin_password: ""
controller_pg_host: localhost
controller_pg_user: postgres
controller_pg_password: ""
gateway_admin_password: ""
gateway_pg_host: localhost
gateway_pg_user: postgres
gateway_pg_password: ""
hub_admin_password: ""
hub_pg_host: localhost
hub_pg_user: postgres
hub_pg_password: ""
eda_admin_password: ""
eda_pg_host: localhost
eda_pg_user: postgres
eda_pg_password: ""
automationmetrics_admin_password: ""
automationmetrics_pg_host: localhost
automationmetrics_pg_user: postgres
automationmetrics_pg_password: ""
automationmetrics_controller_read_pg_host: localhost
automationmetrics_controller_read_pg_user: postgres
automationmetrics_controller_read_pg_password: ""
