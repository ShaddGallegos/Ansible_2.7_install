---
# Canonical project schema for ~/.ansible/conf/env.yml.
# Populate secrets only in the external file and encrypt it with Ansible Vault.
ANSIBLE_2.7_INSTALL:
  INSTALL_SCOPE: remote
  NONINTERACTIVE: false
  ADMIN_USER: admin
  ADMIN_HOME: /home/admin
  ADMIN_PASSWORD: ""
  ROOT_PASSWORD: ""

  AAP_REMOTE_USER: admin
  AAP_REMOTE_ROOT_PASSWORD: ""
  AAP_REMOTE_IP: ""
  AAP_CONTROLLER_IP: ""
  AAP_SHORTNAME: aap
  AAP_DOMAIN_NAME: prod.spg
  AAP_REMOTE_FQDN: aap.prod.spg
  AAP_CONTROLLER_FQDN: aap.prod.spg
  AAP_CONTROLLER_USER: ""
  AAP_CONTROLLER_SSH_KEY: ""
  AAP_INSTALLER_USER: ""
  AAP_INSTALLER_SSH_KEY: ""

  ANSIBLE_VERBOSITY: ""
  BUNDLE_URL: "https://access.cdn.redhat.com/content/origin/files/sha256/5c/5c0e1834c1ae609ce840865b5aa279b5c5bde9118856b326f77cc5c8bf92d9af/ansible-automation-platform-containerized-setup-bundle-2.7-2-x86_64.tar.gz"
  BUNDLE_FILE: ansible-automation-platform-containerized-setup-bundle-2.7-2-x86_64.tar.gz
  BUNDLE_DIR_NAME: ansible-automation-platform-containerized-setup-bundle-2.7-2-x86_64
  LOCAL_BUNDLE_PATH: ""
  AAP_EXECUTION_PLAYBOOK: install
  AAP_ANSIBLE_PLAYBOOK: ""
  AAP_AUTO_CREATE_ANSIBLE_VENV: true
  AAP_APPLY_COLLECTION_PATCHES: true
  AAP_CLEANUP_BUNDLE_ARCHIVE: true
  AAP_CLEANUP_PURGE_DOWNLOADS: false
  AAP_AUTO_CLEANUP_ON_UNINSTALL: false

  AAP_MIN_CPU: 4
  AAP_MIN_RAM_GB: 16
  AAP_MIN_DISK_GB: 40
  SUBUID_START: 100000
  SUBUID_COUNT: 65536
  ENABLE_PODMAN_SOCKET: true
  ENABLE_ROOTFUL_PODMAN_SOCKET: false

  RHSM_USERNAME: ""
  RHSM_PASSWORD: ""
  RH_OFFLINE_TOKEN: ""
  RH_AH_TOKEN: ""
  CDN_USERNAME: ""
  CDN_PASSWORD: ""
  REDHAT_USERNAME: ""
  REDHAT_PASSWORD: ""
  REDHAT_REGISTRY_USERNAME: ""
  REDHAT_REGISTRY_PASSWORD: ""
  CONSOLE_USERNAME: ""
  CONSOLE_PASSWORD: ""

  INVENTORY_GROWTH_USERNAME: admin
  INVENTORY_GROWTH_PASSWORD: ""
  POSTGRESQL_ADMIN_PASSWORD: ""
  CONTROLLER_ADMIN_PASSWORD: ""
  CONTROLLER_PG_HOST: localhost
  CONTROLLER_PG_USER: postgres
  CONTROLLER_PG_PASSWORD: ""
  GATEWAY_ADMIN_PASSWORD: ""
  GATEWAY_PG_HOST: localhost
  GATEWAY_PG_USER: postgres
  GATEWAY_PG_PASSWORD: ""
  HUB_ADMIN_PASSWORD: ""
  HUB_PG_HOST: localhost
  HUB_PG_USER: postgres
  HUB_PG_PASSWORD: ""
  EDA_ADMIN_PASSWORD: ""
  EDA_PG_HOST: localhost
  EDA_PG_USER: postgres
  EDA_PG_PASSWORD: ""
  AUTOMATIONMETRICS_ADMIN_PASSWORD: ""
  AUTOMATIONMETRICS_PG_HOST: localhost
  AUTOMATIONMETRICS_PG_USER: postgres
  AUTOMATIONMETRICS_PG_PASSWORD: ""
  AUTOMATIONMETRICS_CONTROLLER_READ_PG_HOST: localhost
  AUTOMATIONMETRICS_CONTROLLER_READ_PG_USER: postgres
  AUTOMATIONMETRICS_CONTROLLER_READ_PG_PASSWORD: ""

  AAP_CONTROLLER_HOST: https://aap.prod.spg
  AAP_VALIDATE_CERTS: false
  AAP_CONTROLLER_OAUTH_TOKEN: ""
  AAP_CONTROLLER_USERNAME: admin
  AAP_CONTROLLER_PASSWORD: ""
  AAP_ORG_NAME: AAP 2.7 Install
  AAP_INVENTORY_NAME: AAP 2.7 Install Inventory
  AAP_INVENTORY_DESCRIPTION: Inventory for AAP 2.7 installer workflow
  WORKFLOW_PROJECT_NAME: Ansible_2.7_install
  WORKFLOW_PROJECT_URL: https://github.com/shaddgallegos/Ansible_2.7_install.git
  WORKFLOW_PROJECT_BRANCH: main
  MACHINE_CREDENTIAL_NAME: AAP Install Machine Credential
  MACHINE_CREDENTIAL_USERNAME: admin
  MACHINE_CREDENTIAL_PASSWORD: ""
  REGISTRY_CREDENTIAL_NAME: RH Registry Credential
  JOB_TEMPLATE_PREWORK_NAME: AAP27 Prework
  JOB_TEMPLATE_HOST_IDENTITY_NAME: AAP27 Host Identity
  JOB_TEMPLATE_DOWNLOAD_NAME: AAP27 Download Bundle
  JOB_TEMPLATE_INSTALL_NAME: AAP27 Install
  AAP_WORKFLOW_TEMPLATE_NAME: AAP27 End-to-End Install Workflow
